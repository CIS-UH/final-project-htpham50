<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Organization — Events</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('partials/nav', { page: 'events' }) %>

<main>
  <div class="page-header">
    <h1>Exclusive <em>Events</em></h1>
    <p class="page-subtitle">Schedule and manage VIP events with level-based access control</p>
  </div>

  <% if (flash) { %>
    <div class="flash flash-success">✓ <%= flash %></div>
  <% } %>
  <% if (formError) { %>
    <div class="flash flash-error">⚠ <%= formError %></div>
  <% } %>

  <div class="two-col">

    <!-- CREATE FORM -->
    <div class="panel">
      <div class="panel-header">
        <span class="panel-title">Schedule New Event</span>
      </div>
      <div class="panel-body">
        <form action="/events/create" method="POST">
          <div class="form-group">
            <label for="name">Event Name *</label>
            <input type="text" id="name" name="name" required placeholder="e.g. Annual Gala Dinner">
          </div>
          <div class="form-group">
            <label for="date">Date * <span style="color:var(--text-dim)">(unique per event)</span></label>
            <input type="date" id="date" name="date" required>
          </div>
          <div class="form-group">
            <label for="capacity">Capacity *</label>
            <input type="number" id="capacity" name="capacity" required min="1" placeholder="e.g. 50">
          </div>
          <div class="form-group">
            <label for="level">Required Level *</label>
            <select id="level" name="level" required>
              <option value="">— Select level —</option>
              <option value="Bronze">Bronze (all members)</option>
              <option value="Silver">Silver (Silver & Gold only)</option>
              <option value="Gold">Gold (Gold members only)</option>
            </select>
          </div>
          <button type="submit" class="btn btn-gold" style="width:100%;">+ Schedule Event</button>
        </form>
      </div>
    </div>

    <!-- EVENTS TABLE -->
    <div class="panel">
      <div class="panel-header">
        <span class="panel-title">All Events</span>
        <span style="color:var(--text-muted);font-size:11px;"><%= (events || []).length %> scheduled</span>
      </div>
      <% if (!(events || []).length) { %>
        <div class="empty-state">
          <div class="empty-icon">📅</div>
          <p>No events scheduled yet.</p>
        </div>
      <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Date</th>
              <th>Level</th>
              <th>Capacity</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% (events || []).forEach(function(ev) { %>
            <tr>
              <td><strong style="color:var(--text)"><%= ev.name %></strong></td>
              <td style="color:var(--text-muted);white-space:nowrap;"><%= ev.date %></td>
              <td>
                <span class="badge badge-<%= ev.level.toLowerCase() %>">
                  <%= ev.level %>
                </span>
              </td>
              <td style="color:var(--text-muted);text-align:center;"><%= ev.capacity %></td>
              <td>
                <div class="action-row">
                  <a href="/events/<%= ev.id %>/members" class="btn btn-ghost btn-sm">Roster</a>
                  <button type="button" class="btn btn-edit" onclick="openEditEvent(<%- JSON.stringify(ev) %>)">Edit</button>
                  <form action="/events/delete" method="POST" onsubmit="return confirm('Delete this event? All registrations will also be removed.');">
                    <input type="hidden" name="id" value="<%= ev.id %>">
                    <button type="submit" class="btn btn-danger">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

  </div>
</main>

<!-- EDIT MODAL -->
<div class="modal-overlay" id="editModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title">Edit Event</span>
      <button type="button" class="modal-close" onclick="closeModal('editModal')">✕</button>
    </div>
    <form action="/events/update" method="POST">
      <input type="hidden" id="edit-id" name="id">
      <div class="form-group">
        <label>Event Name *</label>
        <input type="text" id="edit-name" name="name" required>
      </div>
      <div class="form-group">
        <label>Date *</label>
        <input type="date" id="edit-date" name="date" required>
      </div>
      <div class="form-group">
        <label>Capacity *</label>
        <input type="number" id="edit-capacity" name="capacity" required min="1">
      </div>
      <div class="form-group">
        <label>Required Level *</label>
        <select id="edit-level" name="level" required>
          <option value="Bronze">Bronze</option>
          <option value="Silver">Silver</option>
          <option value="Gold">Gold</option>
        </select>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" onclick="closeModal('editModal')">Cancel</button>
        <button type="submit" class="btn btn-gold">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
const editModal = document.getElementById('editModal');
function openEditEvent(ev) {
  document.getElementById('edit-id').value = ev.id || '';
  document.getElementById('edit-name').value = ev.name || '';
  const d = ev.date ? ev.date.toString().substring(0, 10) : '';
  document.getElementById('edit-date').value = d;
  document.getElementById('edit-capacity').value = ev.capacity || '';
  document.getElementById('edit-level').value = ev.level || 'Bronze';
  editModal.classList.add('open');
}
function closeModal() {
  editModal.classList.remove('open');
}
if (editModal) {
  editModal.addEventListener('click', function(e) {
    if (e.target === this) closeModal();
  });
}

</script>

</body>
</html>
